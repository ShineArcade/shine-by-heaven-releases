{"book":"PRO","coverage":{"categoryCounts":{"archaic-connector":3,"archaic-disgrace-term":1,"archaic-lexicon":1,"archaic-mocker-term":14,"archaic-need-phrase":1,"archaic-person-term":4,"archaic-projectile-term":3,"clear-archaic-age-lexicon":2,"clear-archaic-complicity-lexicon":1,"clear-archaic-conditional-phrase":1,"clear-archaic-connector":1,"clear-archaic-diligence-lexicon":1,"clear-archaic-erasure-lexicon":1,"clear-archaic-fill-lexicon":1,"clear-archaic-finite-enclitic-order":1,"clear-archaic-foolishness-lexicon":4,"clear-archaic-formation-phrase":1,"clear-archaic-hunting-phrase":1,"clear-archaic-instruction-lexicon":1,"clear-archaic-lending-lexicon":1,"clear-archaic-lexicon":1,"clear-archaic-light-lexicon":2,"clear-archaic-motion-lexicon":1,"clear-archaic-preparation-lexicon":1,"clear-archaic-prosperity-lexicon":1,"clear-archaic-quantity-phrase":1,"clear-archaic-reliance-phrase":1,"clear-archaic-speed-phrase":1,"clear-archaic-spice-lexicon":1,"clear-archaic-status-phrase":1,"clear-archaic-storage-lexicon":1,"clear-archaic-temporal-phrase":1,"clear-archaic-wrongdoing-lexicon":1,"context-reviewed-clear-old-testament-lexicon":4,"context-reviewed-deception-phrase":1,"context-reviewed-delight-phrase":1,"context-reviewed-diligent-search-phrase":1,"context-reviewed-enticement-phrase":1,"context-reviewed-flattery-lexicon":2,"context-reviewed-flattery-phrase":1,"context-reviewed-forced-labor-phrase":1,"context-reviewed-inexperience-lexicon":2,"context-reviewed-knowledge-lexicon":1,"context-reviewed-old-testament-syntax":4,"context-reviewed-proclamation-phrase":1,"context-reviewed-produce-lexicon":1,"context-reviewed-public-place-phrase":1,"context-reviewed-stubbornness-phrase":1,"context-reviewed-talkative-phrase":1,"context-reviewed-term-family":1},"changedVerses":76,"editCount":83,"editorialPolicyVersion":26,"gate":"legacy-not-migrated","totalProverbsVerses":915},"editionId":"RV1909-LECTURA-2026","editorialStatus":"approved-old-testament-final-audit-v26","method":"Only comprehension-essential, reference-supported wording is projected. Cosmetic orthography, typography and bulk grammar normalization remain canonical.","ownerReview":{"changeSet":"editorial-changes/v26.json","contentVersion":26,"requiredFullTest":true,"review":"Auditoría final del Antiguo Testamento integrada sobre RV v25"},"referenceControl":{"auditArtifact":"tool/proverbs_2026_modern_control_audit.json","copyrightedTextIncluded":false,"primary":"RVR1960","secondary":["RVC","RV2020"]},"schemaVersion":1,"sourceContentSha256":"127ca3b34aa1d111729a8abbb600ff2c1ef34bd12809e4853833cddeda441c73","sourceVersionId":"RV1909","verses":[{"chapter":1,"edits":[{"category":"clear-archaic-lexicon","endOffset":49,"expected":"henchiremos","reason":"Henchir significa llenar; los tres controles confirman el verbo y no cambia el objeto de la acción.","replacement":"llenaremos","startOffset":38}],"sourceTextSha256":"21c679287f7722290cf988fcb7f23666f6250e1502bf646c819f9e2a38286766","verse":13},{"chapter":1,"edits":[{"category":"context-reviewed-public-place-phrase","endOffset":44,"expected":"los principales lugares de concurso","reason":"Concurso significa aquí concurrencia o reunión de personas, no competencia. Los controles sitúan la voz de la sabiduría en lugares transitados o en medio del tumulto; se conserva la proclamación pública.","replacement":"los lugares más concurridos","startOffset":9},{"category":"context-reviewed-proclamation-phrase","endOffset":106,"expected":"dice sus razones","reason":"Decir sus razones significa pronunciar públicamente su mensaje. Los controles usan proclamar, anunciar o explicar; la sustitución aclara la acción sin ampliar su contenido.","replacement":"proclama sus palabras","startOffset":90}],"sourceTextSha256":"2e1a194fe57947c42f4e402e9be08cf492defb7a711762b51cf2dc66f32df8a1","verse":21},{"chapter":1,"edits":[{"category":"context-reviewed-inexperience-lexicon","endOffset":25,"expected":"simples","reason":"Simples designa aquí a quienes carecen de experiencia y discernimiento, no a personas sencillas en sentido positivo. Los controles convergen en ingenuos, inexpertos o insensatos; se conserva el grupo al que habla la sabiduría.","replacement":"ingenuos","startOffset":18},{"category":"context-reviewed-inexperience-lexicon","endOffset":46,"expected":"simpleza","reason":"Simpleza es la falta de experiencia o discernimiento amada por los ingenuos. Ingenuidad mantiene la relación con el sustantivo anterior y evita que se entienda como facilidad o sencillez.","replacement":"ingenuidad","startOffset":38},{"category":"context-reviewed-knowledge-lexicon","endOffset":124,"expected":"la ciencia","reason":"Ciencia significa aquí conocimiento o saber moral, no una disciplina científica. Los controles convergen en conocimiento o saber; se cambia también el artículo para conservar la concordancia.","replacement":"el conocimiento","startOffset":114}],"sourceTextSha256":"f20d403d025a3d84029cd5adf645e51f9435a7c59ac0b352ddb2fc3c5ed15d7a","verse":22},{"chapter":1,"edits":[{"category":"context-reviewed-diligent-search-phrase","endOffset":61,"evidence":[{"label":"Comparación de Proverbios 1:28","url":"https://www.biblegateway.com/passage/?search=Proverbios%201%3A28&version=RVR1960%3BRVA-2015"}],"expected":"buscarme han de mañana","reason":"Buscar de mañana expresa buscar con empeño o diligencia, no limitar la búsqueda a una hora del día. La forma verbal separada es además arcaica; la unidad moderna conserva sujeto, acción y resultado.","replacement":"me buscarán con diligencia","startOffset":39}],"sourceTextSha256":"b6273f1c2fc20e6808abe7bd595ffd3779e31c9b3fbfc5fdaf8d28293c029bd8","verse":28},{"chapter":2,"edits":[{"category":"clear-archaic-age-lexicon","endOffset":39,"expected":"mocedad","reason":"Mocedad designa la juventud. La equivalencia es directa en los tres controles.","replacement":"juventud","startOffset":32}],"sourceTextSha256":"0c328880010e138aadd2123172844a7c2bb9c38c369775765b1f07accc9ab583","verse":17},{"chapter":3,"edits":[{"category":"clear-archaic-reliance-phrase","endOffset":49,"expected":"estribes","reason":"Estribar significa apoyarse o fundarse en algo. Los tres controles confirman el sentido de dependencia y el sujeto permanece intacto.","replacement":"te apoyes","startOffset":41}],"sourceTextSha256":"d70609e15c197a4a10e8ad545600cb1f15c799815b0c149cc19bf0f970f67275","verse":5},{"chapter":3,"edits":[{"category":"clear-archaic-storage-lexicon","endOffset":25,"expected":"trojes","reason":"Trojes son depósitos o graneros para productos agrícolas. Los controles convergen en graneros; se cambia solo el sustantivo.","replacement":"graneros","startOffset":19},{"category":"context-reviewed-produce-lexicon","endOffset":74,"expected":"mosto","reason":"Mosto designa aquí el vino nuevo que rebosa de los lagares. Los controles modernos confirman vino o vino nuevo; la sustitución mantiene la imagen de abundancia agrícola.","replacement":"vino nuevo","startOffset":69}],"sourceTextSha256":"b787ea3be91851820c85febaaebf6e5e2ae197ae046fb8a88dd14483c2f4670c","verse":10},{"chapter":3,"edits":[{"category":"archaic-mocker-term","endOffset":47,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+3%3A34&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=PRO+3%3A34&version=NVI"}],"expected":"escarnecedores","reason":"Escarnecedores designa a quienes se burlan de otros o de la corrección.","replacement":"burladores","startOffset":33}],"sourceTextSha256":"ac863e1e7315ad87e07feed2cc0fe681a8fe82b7072ed9e1e9fbeb45f4d3c79b","verse":34},{"chapter":3,"edits":[{"category":"context-reviewed-clear-old-testament-lexicon","endOffset":63,"expected":"ignominia","reason":"RVR1960 conserva el término histórico y NVI confirma por contexto el sentido actual. La sustitución aclara la lectura sin cambiar la persona, acción ni relación del pasaje.","replacement":"deshonra","startOffset":54}],"sourceTextSha256":"39c409ef102bbcf4ea72174799b7bac39b34a2efa4aad695f58443a5e5c02939","verse":35},{"chapter":5,"edits":[{"category":"clear-archaic-temporal-phrase","endOffset":27,"expected":"en tus postrimerías","reason":"La expresión señala el final de la vida o del proceso descrito. Los tres controles confirman la referencia temporal.","replacement":"al final","startOffset":8}],"sourceTextSha256":"659f254a301bd1566292943b42699d198c1ecbd664de9fd38734ed6f3edb98d1","verse":11},{"chapter":5,"edits":[{"category":"clear-archaic-instruction-lexicon","endOffset":41,"expected":"adoctrinaban","reason":"Adoctrinar se usa aquí como instruir. La equivalencia verbal aparece en los tres controles.","replacement":"instruían","startOffset":29}],"sourceTextSha256":"72cfaafca1f368f751cb4b7feded154ea33b6d8e6cbce95c24f0c9d00ff6b4f0","verse":13},{"chapter":6,"edits":[{"category":"clear-archaic-hunting-phrase","endOffset":85,"expected":"parancero","reason":"Parancero es quien pone trampas para aves. Los controles confirman la acción sin alterar la comparación.","replacement":"que arma lazos","startOffset":76}],"sourceTextSha256":"36aa9119e2da775d5770a4022280bf1d802889c376a9ba9b53325a9d6d1b3d5d","verse":5},{"chapter":6,"edits":[{"category":"archaic-person-term","endOffset":33,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+6%3A26&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=PRO+6%3A26&version=NVI"}],"expected":"ramera","reason":"Ramera es el término antiguo para prostituta; se conserva el uso literal o figurado del pasaje.","replacement":"prostituta","startOffset":27}],"sourceTextSha256":"ad06834941d6f27461992b6601dd95475a718cc05777269e6c18e32aacb63460","verse":26},{"chapter":6,"edits":[{"category":"clear-archaic-conditional-phrase","endOffset":13,"expected":"Empero tomado","reason":"La construcción antigua introduce la condición de que el ladrón sea sorprendido. Los tres controles sostienen esa condición.","replacement":"Pero si es sorprendido","startOffset":0},{"category":"clear-archaic-quantity-phrase","endOffset":31,"expected":"las setenas","reason":"Setenas significa siete veces. La cantidad permanece idéntica en los tres controles.","replacement":"siete veces","startOffset":20}],"sourceTextSha256":"3e96a2016d3a0e3d6eb9072388367bd44872e944ba7e16df6252957f5c53858d","verse":31},{"chapter":6,"edits":[{"category":"clear-archaic-erasure-lexicon","endOffset":56,"expected":"raída","reason":"Raer significa borrar. Los controles confirman que la afrenta no será borrada.","replacement":"borrada","startOffset":51}],"sourceTextSha256":"51e5b613b7e25c23f759f96b394901e5bea942adeb40c82ee97f8fbbb06df7bb","verse":33},{"chapter":7,"edits":[{"category":"clear-archaic-age-lexicon","endOffset":61,"expected":"mancebo","reason":"Mancebo designa a un joven. Los tres controles coinciden en la edad expresada.","replacement":"joven","startOffset":54}],"sourceTextSha256":"a2740f91b572f3c20d8c30828ba72e1b79ff61b6488601c19d4b6f5e5c8d8858","verse":7},{"chapter":7,"edits":[{"category":"archaic-person-term","endOffset":66,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+7%3A10&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=PRO+7%3A10&version=NVI"}],"expected":"ramera","reason":"Ramera es el término antiguo para prostituta; se conserva el uso literal o figurado del pasaje.","replacement":"prostituta","startOffset":60}],"sourceTextSha256":"1a3eafc506f69200f042f151bf92cd217966d2a969f8cfa7b025319349c2aa64","verse":10},{"chapter":7,"edits":[{"category":"clear-archaic-spice-lexicon","endOffset":50,"expected":"cinamomo","reason":"Cinamomo es canela. Los tres controles confirman la misma especia y se conserva el verbo de la imagen canónica.","replacement":"canela","startOffset":42}],"sourceTextSha256":"53d4cda717205f9b67a36a0bf201621b8715f977d47ca4906d93add781128e3e","verse":17},{"chapter":7,"edits":[{"category":"archaic-projectile-term","endOffset":88,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+7%3A23&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=PRO+7%3A23&version=NVI"}],"expected":"saeta","reason":"Saeta designa una flecha, tanto literal como figuradamente.","replacement":"flecha","startOffset":83}],"sourceTextSha256":"0b5030843bb61065a78b759786ae94d281fde44b6e292b290313990f778597e6","verse":23},{"chapter":8,"edits":[{"category":"context-reviewed-delight-phrase","endOffset":82,"expected":"teniendo solaz","reason":"Tener solaz significa deleitarse o regocijarse. La forma moderna conserva la alegría continua expresada por la sabiduría ante Dios.","replacement":"regocijándome","startOffset":68}],"sourceTextSha256":"b32d3c832c2114e3e20a5acecda9b3050de29b0755b81b786eeee8594a9be78f","verse":30},{"chapter":9,"edits":[{"category":"archaic-mocker-term","endOffset":30,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+9%3A7&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=PRO+9%3A7&version=NVI"}],"expected":"escarnecedor","reason":"Escarnecedor designa a quien se burla de otros o de la corrección.","replacement":"burlador","startOffset":18}],"sourceTextSha256":"b811cd600830c5d075b9bb36a9257698a62188ad722051f53218de4b6b19e9b1","verse":7},{"chapter":9,"edits":[{"category":"archaic-mocker-term","endOffset":28,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+9%3A8&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=PRO+9%3A8&version=NVI"}],"expected":"escarnecedor","reason":"Escarnecedor designa a quien se burla de otros o de la corrección.","replacement":"burlador","startOffset":16}],"sourceTextSha256":"76b467751f72f44626e34fe496d0f639c0539eb820dda47327752c879d570737","verse":8},{"chapter":9,"edits":[{"category":"archaic-mocker-term","endOffset":61,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+9%3A12&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=PRO+9%3A12&version=NVI"}],"expected":"escarnecedor","reason":"Escarnecedor designa a quien se burla de otros o de la corrección.","replacement":"burlador","startOffset":49}],"sourceTextSha256":"e291404a5771f035977a805d0cca34ff094ac4a33ab48efb4dd733f39371c5a9","verse":12},{"chapter":12,"edits":[{"category":"context-reviewed-forced-labor-phrase","endOffset":76,"evidence":[{"label":"Controles RVR1960, NVI, LBLA y RVC","url":"https://www.biblegateway.com/passage/?search=PRO+12:24&version=RVR1960;NVI;LBLA;RVC"}],"expected":"será tributaria","reason":"Ser tributaria significa aquí quedar sometida a trabajo forzado, no solamente pagar un impuesto. Los controles explicativos confirman el contraste entre gobernar y servir; se cambia solo la consecuencia de la negligencia. RV1909 escribe estas formas siempre con tilde: a lo largo del Antiguo Testamento aparecen á 14 734 veces y a ninguna, fué 1 159 y fue ninguna, dió 231 y dio ninguna. El reemplazo se alinea con la ortografia del texto base para que la lectura no cambie de un capitulo a otro.","replacement":"será sometida á trabajos forzados","startOffset":61}],"sourceTextSha256":"a5519a54b7f8808c3e22bc3982d6038b13d40a742a3e912cc41a9f82a59cb645","verse":24},{"chapter":13,"edits":[{"category":"context-reviewed-old-testament-syntax","endOffset":62,"expected":"avisados","reason":"Se reorganiza la construcción futura antigua según el español actual. RVR1960 y NVI confirman la misma acción y el mismo objeto; no se copia su redacción completa.","replacement":"prudentes","startOffset":54}],"sourceTextSha256":"fb90f519ed378c7085b65b04f7a9d60fc61e58d6c8a50c6a78b60a5ba6dbef73","verse":10},{"chapter":13,"edits":[{"category":"archaic-connector","endOffset":45,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+13%3A11&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=PRO+13%3A11&version=NVI"}],"expected":"empero","reason":"Empero es un conector antiguo equivalente a pero.","replacement":"pero","startOffset":39}],"sourceTextSha256":"b65a84765d3199d04f19ff2ce0a7279545accb7f67ce607ecc9c32cdadf911b3","verse":11},{"chapter":13,"edits":[{"category":"clear-archaic-wrongdoing-lexicon","endOffset":76,"expected":"prevaricadores","reason":"Approved by the global consistency review after complete-verse and three-control verification.","replacement":"transgresores","startOffset":62}],"sourceTextSha256":"920f84873636cc313462eb70f113f28857a6f452a9884e1f157de104e87eb646","verse":15},{"chapter":14,"edits":[{"category":"archaic-mocker-term","endOffset":21,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+14%3A6&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=PRO+14%3A6&version=NVI"}],"expected":"escarnecedor","reason":"Escarnecedor designa a quien se burla de otros o de la corrección.","replacement":"burlador","startOffset":9}],"sourceTextSha256":"0d497262d40ca29d4132f283f1b4d6352881c8a98bc87b3daca75e58521bb9e8","verse":6},{"chapter":14,"edits":[{"category":"clear-archaic-connector","endOffset":47,"expected":"empero","reason":"Empero significa pero. Los tres controles confirman el mismo contraste.","replacement":"pero","startOffset":41}],"sourceTextSha256":"1097ab4906ef86bfaa4c6f6fc8ce631215207a451e0ee8d81ca979975e11b14c","verse":12},{"chapter":14,"edits":[{"category":"context-reviewed-old-testament-syntax","endOffset":45,"expected":"avisado","reason":"Se reorganiza la construcción futura antigua según el español actual. RVR1960 y NVI confirman la misma acción y el mismo objeto; no se copia su redacción completa.","replacement":"prudente","startOffset":38}],"sourceTextSha256":"68c4bc85726b13a5327836a18cb503fbc54250d1142ede3efb2586081f5b6b7b","verse":15},{"chapter":14,"edits":[{"category":"archaic-connector","endOffset":51,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+14%3A22&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=PRO+14%3A22&version=NVI"}],"expected":"empero","reason":"Empero es un conector antiguo equivalente a pero.","replacement":"pero","startOffset":45}],"sourceTextSha256":"b70e28e03f43e1e731ea92d363ef42ba709ab76af28c757ce29c482d033ab7ab","verse":22},{"chapter":15,"edits":[{"category":"archaic-connector","endOffset":47,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+15%3A6&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=PRO+15%3A6&version=NVI"}],"expected":"empero","reason":"Empero es un conector antiguo equivalente a pero.","replacement":"pero","startOffset":41}],"sourceTextSha256":"4533ab93141f5f370efad6af89254fd7c5dcc74f11f019e835c302af2eb928d2","verse":6},{"chapter":15,"edits":[{"category":"archaic-mocker-term","endOffset":15,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+15%3A12&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=PRO+15%3A12&version=NVI"}],"expected":"escarnecedor","reason":"Escarnecedor designa a quien se burla de otros o de la corrección.","replacement":"burlador","startOffset":3}],"sourceTextSha256":"65784d0b965aeb1e0b96f0054c286da0f472044ce3c12c06ffb4bdb1b27200da","verse":12},{"chapter":16,"edits":[{"category":"context-reviewed-enticement-phrase","endOffset":36,"evidence":[{"label":"Controles RVR1960, NVI, LBLA y RVC","url":"https://www.biblegateway.com/passage/?search=PRO+16:29&version=RVR1960;NVI;LBLA;RVC"}],"expected":"lisonjea á su prójimo","reason":"En este contexto el hombre malo persuade o seduce a su prójimo para llevarlo por mal camino. Los controles convergen en persuadir, seducir o engañar; no se trata de un elogio inocente. RV1909 escribe estas formas siempre con tilde: a lo largo del Antiguo Testamento aparecen á 14 734 veces y a ninguna, fué 1 159 y fue ninguna, dió 231 y dio ninguna. El reemplazo se alinea con la ortografia del texto base para que la lectura no cambie de un capitulo a otro.","replacement":"seduce á su prójimo","startOffset":15}],"sourceTextSha256":"c5a2c232664c408bff75dc5e3665499654087337e62df1b2773b443c4b5cbe35","verse":29},{"chapter":17,"edits":[{"category":"archaic-lexicon","endOffset":29,"expected":"cohecho","reason":"Approved by the global consistency review after complete-verse and three-control verification.","replacement":"soborno","startOffset":22}],"sourceTextSha256":"0648762bf3b2e3258bb029d034055b9824197c323d6a3d950f0057be0bd3c0a8","verse":8},{"chapter":17,"edits":[{"category":"clear-archaic-foolishness-lexicon","endOffset":96,"evidence":[{"label":"Controles RVR1960, NVI, LBLA y RVC","url":"https://www.biblegateway.com/passage/?search=PRO+17:12&version=RVR1960;NVI;LBLA;RVC"}],"expected":"fatuo","reason":"Fatuo designa aquí al necio en su necedad. Los controles coinciden en necio o un equivalente directo; cambia un solo sustantivo. La capa resolvia este mismo termino de dos maneras distintas en pasajes equivalentes. Se unifica la lectura; donde la palabra cubre dos sentidos hebreos distintos la divergencia se conserva.","replacement":"insensato","startOffset":91}],"sourceTextSha256":"ab47902d1bef7a6c12928c2d920d47bdf2baa65a6b455bb441c5cc6744273afb","verse":12},{"chapter":17,"edits":[{"category":"clear-archaic-foolishness-lexicon","endOffset":76,"expected":"fatuo","reason":"Fatuo significa insensato en el paralelismo con necio. Los controles modernos confirman ese sentido.","replacement":"insensato","startOffset":71}],"sourceTextSha256":"cb0cd28a31d12d869bd6fbb02ba549da59f785a9cd4f738b3224d225e684ad21","verse":21},{"chapter":18,"edits":[{"category":"clear-archaic-foolishness-lexicon","endOffset":52,"expected":"fatuidad","reason":"Fatuidad significa necedad en la respuesta dada antes de escuchar. Los controles modernos convergen en necedad o insensatez; se conserva la vergüenza que acompaña la acción.","replacement":"necedad","startOffset":44},{"category":"archaic-disgrace-term","endOffset":62,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+18%3A13&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=PRO+18%3A13&version=NVI"}],"expected":"oprobio","reason":"Oprobio expresa deshonra o vergüenza pública.","replacement":"deshonra","startOffset":55}],"sourceTextSha256":"a6411e099ee4aaeebaf2e6034acc8f989baf3a2bfd4d78b4114f7e0f763a70eb","verse":13},{"chapter":19,"edits":[{"category":"clear-archaic-foolishness-lexicon","endOffset":80,"evidence":[{"label":"Controles RVR1960, NVI, LBLA y RVC","url":"https://www.biblegateway.com/passage/?search=PRO+19:1&version=RVR1960;NVI;LBLA;RVC"}],"expected":"fatuo","reason":"Fatuo designa aquí a una persona necia. Los controles coinciden en necio o equivalente; no se cambia el contraste con el pobre íntegro. La capa resolvia este mismo termino de dos maneras distintas en pasajes equivalentes. Se unifica la lectura; donde la palabra cubre dos sentidos hebreos distintos la divergencia se conserva.","replacement":"insensato","startOffset":75}],"sourceTextSha256":"032cf745194980dff4df440aed68b144e8f7879c64476bd0044301e7042f6567","verse":1},{"chapter":19,"edits":[{"category":"archaic-mocker-term","endOffset":21,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=PRO+19%3A25&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.bib