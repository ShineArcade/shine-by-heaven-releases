:[{"category":"clear-archaic-finite-enclitic-order","endOffset":92,"expected":"harálos","reason":"Se coloca el pronombre antes del verbo finito según el español actual, sin cambiar la acción, sus participantes ni el contenido del versículo.","replacement":"los hará","startOffset":85}],"sourceTextSha256":"d4b423d8182fdacb48ddd95a06204e171afdb5eaf11ca1017f24adc8a4965a7f","verse":39},{"chapter":11,"edits":[{"category":"archaic-connector","endOffset":6,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=DAN+11%3A40&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=DAN+11%3A40&version=NVI"}],"expected":"Empero","reason":"Empero es un conector antiguo equivalente a pero.","replacement":"Pero","startOffset":0},{"category":"archaic-direction","endOffset":45,"expected":"mediodía","reason":"Mediodía designa sur. Los tres controles confirman sur y se conserva la oposición norte-sur.","replacement":"sur","startOffset":37}],"sourceTextSha256":"b974dcb502dc061e1d9abf2440926405ffd30b83ed045f187dd29e38b5626e00","verse":40},{"chapter":12,"edits":[{"category":"archaic-connector","endOffset":9,"evidence":[{"label":"Control contextual RVR1960","url":"https://www.biblegateway.com/passage/?search=DAN+12%3A4&version=RVR1960"},{"label":"Control contextual NVI","url":"https://www.biblegateway.com/passage/?search=DAN+12%3A4&version=NVI"}],"expected":"empero","reason":"Empero es un conector antiguo equivalente a pero.","replacement":"pero","startOffset":3}],"sourceTextSha256":"8448fcf627d3b2337a46b7ca521f3d04ed948be47625ab3891f95333fecd1feb","verse":4}]}
