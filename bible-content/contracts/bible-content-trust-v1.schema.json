{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinebyheaven.app/contracts/bible-content-trust-v1.schema.json",
  "title": "SHINE Bible Content Trust Store v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "keys"
  ],
  "properties": {
    "format": {
      "const": "shine-bible-content-trust-store"
    },
    "schemaVersion": {
      "const": 1
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "algorithm",
          "status",
          "publicKeyPem",
          "validFrom",
          "validUntil"
        ],
        "properties": {
          "keyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,120}$"
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "status": {
            "enum": [
              "active",
              "revoked"
            ]
          },
          "publicKeyPem": {
            "type": "string",
            "minLength": 40
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
