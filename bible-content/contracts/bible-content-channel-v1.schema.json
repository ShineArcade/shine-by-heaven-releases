{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinebyheaven.app/contracts/bible-content-channel-v1.schema.json",
  "title": "SHINE Public Bible Content Channel v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "payload",
    "contentSha256",
    "signature"
  ],
  "properties": {
    "format": {
      "const": "shine-public-bible-content-channel"
    },
    "schemaVersion": {
      "const": 1
    },
    "payload": {
      "$ref": "#/$defs/channelPayload"
    },
    "contentSha256": {
      "$ref": "#/$defs/sha256"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "channelPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channelId",
        "contentVersion",
        "issuedAt",
        "expiresAt",
        "distributionScope",
        "updatePolicy",
        "artifacts"
      ],
      "properties": {
        "channelId": {
          "const": "shine-public-bible-stable"
        },
        "contentVersion": {
          "type": "integer",
          "minimum": 1
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "distributionScope": {
          "const": "public"
        },
        "updatePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "versionAuthority",
            "issuedAtRole",
            "equalVersionEqualHash",
            "equalVersionDifferentHash",
            "lowerVersion",
            "higherVersion"
          ],
          "properties": {
            "versionAuthority": {
              "const": "contentVersion"
            },
            "issuedAtRole": {
              "const": "audit-only"
            },
            "equalVersionEqualHash": {
              "const": "no-op"
            },
            "equalVersionDifferentHash": {
              "const": "reject-conflict"
            },
            "lowerVersion": {
              "const": "reject-downgrade"
            },
            "higherVersion": {
              "const": "accept-after-verification"
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/rv1909Artifact"
            },
            {
              "$ref": "#/$defs/reading2026Artifact"
            }
          ],
          "items": false
        }
      }
    },
    "commonArtifact": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contentVersion": {
          "type": "integer",
          "minimum": 1
        },
        "sourceVersionId": {
          "const": "RV1909"
        },
        "sourceCorpusSha256": {
          "const": "af7a0acc03b228719b549539dcd0dcaca3c40af51a4b3d6c96f51ec8510ec739"
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "mimeType": {
          "const": "application/json+gzip"
        },
        "artifactPath": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "expectedBookCount": {
          "const": 66
        },
        "includedBookCount": {
          "const": 66
        }
      }
    },
    "rv1909Artifact": {
      "allOf": [
        {
          "$ref": "#/$defs/commonArtifact"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "schemaVersion",
            "contentVersion",
            "sourceVersionId",
            "sourceCorpusSha256",
            "contentSha256",
            "sizeBytes",
            "mimeType",
            "artifactPath",
            "expectedBookCount",
            "includedBookCount",
            "rights"
          ],
          "properties": {
            "kind": {
              "const": "bible-corpus"
            },
            "id": {
              "const": "RV1909"
            },
            "schemaVersion": {},
            "contentVersion": {},
            "sourceVersionId": {},
            "sourceCorpusSha256": {},
            "contentSha256": {},
            "sizeBytes": {},
            "mimeType": {},
            "artifactPath": {},
            "expectedBookCount": {},
            "includedBookCount": {},
            "rights": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "license",
                "copyright",
                "rightsUrl"
              ],
              "properties": {
                "license": {
                  "type": "string",
                  "minLength": 1
                },
                "copyright": {
                  "type": "string",
                  "minLength": 1
                },
                "rightsUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      ]
    },
    "reading2026Artifact": {
      "allOf": [
        {
          "$ref": "#/$defs/commonArtifact"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "schemaVersion",
            "contentVersion",
            "sourceVersionId",
            "sourceCorpusSha256",
            "contentSha256",
            "sizeBytes",
            "mimeType",
            "artifactPath",
            "expectedBookCount",
            "includedBookCount",
            "coverage",
            "editorialPolicy"
          ],
          "properties": {
            "kind": {
              "const": "reading-filter"
            },
            "id": {
              "const": "RV1909-LECTURA-2026"
            },
            "schemaVersion": {},
            "contentVersion": {},
            "sourceVersionId": {},
            "sourceCorpusSha256": {},
            "contentSha256": {},
            "sizeBytes": {},
            "mimeType": {},
            "artifactPath": {},
            "expectedBookCount": {},
            "includedBookCount": {},
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "changedVerseCount",
                "editCount"
              ],
              "properties": {
                "changedVerseCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "editCount": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "editorialPolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version",
                "description"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "signedObject",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,120}$"
        },
        "signedObject": {
          "const": "payload"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
